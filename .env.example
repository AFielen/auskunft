# DRK Selbstauskunft - Environment Variables

# App-URL (wird im Build inlined für NEXT_PUBLIC_)
# Produktion: https://drk-selfaudit.de
# Lokal: http://localhost:3333
NEXT_PUBLIC_APP_URL=https://drk-selfaudit.de

# Instanz-ID für Feedback-System (Privacy-by-Design)
# Nur Feedback von dieser ID wird gespeichert
# Generiert beim ersten App-Start (siehe /hilfe für deine ID)
DRK_INSTANCE_ID=
